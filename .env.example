TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: dedicated bot/channel for the liquidity scalp stream (M1 XAUUSD)
# TELEGRAM_SCALP_BOT_TOKEN=
# TELEGRAM_SCALP_CHAT_ID=
# Optional: Finnhub API key for reliable economic calendar data
# FINNHUB_API_KEY=
# Main Trading Boss XAUUSD pricing: Binance XAUUSDT (default)
# Optional OANDA: MAIN_XAUUSD_USE_OANDA=1 + credentials below
# Optional MT5/Moneta (main only — SPACE stays Binance): MAIN_XAUUSD_USE_MT5=1 + bridge on Windows PC
# MAIN_XAUUSD_USE_OANDA=0
# MAIN_XAUUSD_USE_MT5=0
# MT5_SYMBOL=XAUUSD
# MT5_BRIDGE_URL=http://100.x.x.x:8765
# MT5_BRIDGE_TOKEN=
# OANDA_API_KEY=
# OANDA_ACCOUNT_ID=
# OANDA_ENV=practice
# Trading Boss killzone profile: precision (1m/5m, smaller SL) or standard (5m/15m)
# TRADING_BOSS_KILLZONE_PROFILE=precision
# Killzone frequency (legacy single-tier): balanced or daily — ignored when dual tier ON
# TRADING_BOSS_KILLZONE_FREQUENCY=daily
# Dual tier: ACTIVE (частіші) + SELECT (рідкісні, якісні) в одному main Telegram
# TRADING_BOSS_DUAL_TIER=1
# Main scan interval in seconds (60 recommended for daily, 120 for balanced)
# SCAN_INTERVAL_SECONDS=120
# Optional: comma-separated symbols for multi-symbol runs
# TRADING_SYMBOLS=BTCUSDT,XAUUSD,DJ30
#
# TradingView → main Telegram (separate from bot strategy; SPACE unchanged)
# 24/7: bash tools/setup_tv_systemd.sh  (on VPS as root)
# Manual: python tools/tradingview_webhook.py
# Put behind HTTPS: https://YOUR-DOMAIN/tv/webhook?token=YOUR_SECRET
# TRADINGVIEW_WEBHOOK_SECRET=
# TRADINGVIEW_WEBHOOK_HOST=127.0.0.1
# TRADINGVIEW_WEBHOOK_PORT=8788
