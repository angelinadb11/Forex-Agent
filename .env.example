TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: dedicated bot/channel for the liquidity scalp stream (M1 XAUUSD)
# TELEGRAM_SCALP_BOT_TOKEN=
# TELEGRAM_SCALP_CHAT_ID=
# Optional: Finnhub API key for reliable economic calendar data
# FINNHUB_API_KEY=
# OANDA v20 REST — main Trading Boss channel XAUUSD pricing (SPACE/scalp stays on Binance)
# OANDA_API_KEY=
# OANDA_ACCOUNT_ID=
# OANDA_ENV=practice
# Trading Boss killzone profile: precision (1m/5m, smaller SL) or standard (5m/15m)
# TRADING_BOSS_KILLZONE_PROFILE=precision
# Killzone frequency (legacy single-tier): balanced or daily — ignored when dual tier ON
# TRADING_BOSS_KILLZONE_FREQUENCY=daily
# Dual tier: ACTIVE (частіші) + SELECT (рідкісні, якісні) в одному main Telegram
# TRADING_BOSS_DUAL_TIER=1
# Main scan interval in seconds (60 recommended for daily, 120 for balanced)
# SCAN_INTERVAL_SECONDS=120
# Optional: comma-separated symbols for multi-symbol runs
# TRADING_SYMBOLS=BTCUSDT,XAUUSD,DJ30
