[Unit]
Description=Forex Agent trading bot (24/7)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/Forex-Agent
EnvironmentFile=-/root/Forex-Agent/.env
ExecStart=/root/Forex-Agent/.venv/bin/python main.py
Restart=always
RestartSec=10
TimeoutStopSec=30
KillMode=mixed

[Install]
WantedBy=multi-user.target
